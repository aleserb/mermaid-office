<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>9e2ab43d-705f-4f59-b861-a2b35eca6d41</Id>
  <Version>1.0.34.0</Version>
  <ProviderName>aleserb</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Mermaid Office"/>
  <Description DefaultValue="Create and edit Mermaid diagrams in Microsoft Word."/>
  <IconUrl DefaultValue="https://aleserb.github.io/mermaid-office/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://aleserb.github.io/mermaid-office/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/aleserb/mermaid-office/issues"/>
  <AppDomains>
    <AppDomain>https://aleserb.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ImageCoercion" MinVersion="1.1"/>
      <Set Name="WordApi" MinVersion="1.4"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://aleserb.github.io/mermaid-office/?v=1.0.34"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="WordApi" MinVersion="1.4"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="MermaidOffice.GetStarted.Title"/>
            <Description resid="MermaidOffice.GetStarted.Desc"/>
            <LearnMoreUrl resid="MermaidOffice.LearnMore.Url"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabInsert">
              <Group id="MermaidOffice.InsertGroup">
                <Label resid="MermaidOffice.Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="MermaidOffice.Icon.16"/>
                  <bt:Image size="32" resid="MermaidOffice.Icon.32"/>
                  <bt:Image size="80" resid="MermaidOffice.Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="MermaidOffice.PaneButton">
                  <Label resid="MermaidOffice.Pane.Label"/>
                  <Supertip>
                    <Title resid="MermaidOffice.Pane.Label"/>
                    <Description resid="MermaidOffice.Pane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="MermaidOffice.Icon.16"/>
                    <bt:Image size="32" resid="MermaidOffice.Icon.32"/>
                    <bt:Image size="80" resid="MermaidOffice.Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>MermaidOffice.Pane</TaskpaneId>
                    <SourceLocation resid="MermaidOffice.Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image
          id="MermaidOffice.Icon.16"
          DefaultValue="https://aleserb.github.io/mermaid-office/assets/icon-16.png"/>
        <bt:Image
          id="MermaidOffice.Icon.32"
          DefaultValue="https://aleserb.github.io/mermaid-office/assets/icon-32.png"/>
        <bt:Image
          id="MermaidOffice.Icon.80"
          DefaultValue="https://aleserb.github.io/mermaid-office/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url
          id="MermaidOffice.Taskpane.Url"
          DefaultValue="https://aleserb.github.io/mermaid-office/?v=1.0.34"/>
        <bt:Url
          id="MermaidOffice.LearnMore.Url"
          DefaultValue="https://github.com/aleserb/mermaid-office"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="MermaidOffice.Group.Label" DefaultValue="Mermaid"/>
        <bt:String id="MermaidOffice.Pane.Label" DefaultValue="Mermaid"/>
        <bt:String
          id="MermaidOffice.GetStarted.Title"
          DefaultValue="Create Mermaid diagrams in Word"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String
          id="MermaidOffice.Pane.Tooltip"
          DefaultValue="Open the Mermaid pane to insert or edit diagrams, with live updates directly in Word."/>
        <bt:String
          id="MermaidOffice.GetStarted.Desc"
          DefaultValue="Use Insert > Mermaid to create a diagram or edit the selected Mermaid diagram."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
